# EV ChargeHub Backend - Environment Variables Example
# Copy this file to .env and update values as needed

# Security
SECRET_KEY=ev-chargehub-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Note: SQLite paths starting with sqlite:///./ are resolved relative to the backend folder
SQLALCHEMY_DATABASE_URL=sqlite:///./ev_chargehub.db

# Server
HOST=0.0.0.0
PORT=8000

# Seeding User Credentials
ADMIN_EMAIL=admin@evchargehub.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

USER_JOHN_EMAIL=john@example.com
USER_JOHN_USERNAME=john_doe
USER_JOHN_PASSWORD=User@123

USER_SARAH_EMAIL=sarah@example.com
USER_SARAH_USERNAME=sarah_smith
USER_SARAH_PASSWORD=User@123

USER_MIKE_EMAIL=mike@example.com
USER_MIKE_USERNAME=mike_jones
USER_MIKE_PASSWORD=User@123
